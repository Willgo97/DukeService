[{"id":"virtu","name":"Virtu","series":"10, 18 / 38, 20, 40, 50, 60 and 80, 70 and 90, 180, 190","typeCode":"CEC / CND / FEC / FND / IEA / INB / XEA / XNA","brewer":"CoEx, CoEx XL, Filterfresh, Instant","cabinet":"Medium, Small","screen":"10,4\" touchscreen","active":true,"summary":"Nadčasový kávovar na zrna se spařovačem CoEx a přizpůsobitelným nerezovým čelem.","description":"Espreso z čerstvých zrn, čerstvá filtrovaná káva a klasické instantní nápoje. Horká voda a volitelně chlazená voda, neperlivá nebo perlivá. Nerezové čelo lze přizpůsobit podle místa. Detekce kelímku spustí přípravu až ve chvíli, kdy kelímek stojí na místě.","specs":[{"label":"Height","small":"815 mm","medium":"890 mm"},{"label":"Height with bean canister","small":"860 mm","medium":"1020 mm"},{"label":"Width","small":"365 mm","medium":"426 mm"},{"label":"Depth","small":"504 mm – 544 mm","medium":"590 mm"},{"label":"Weight","small":"40 kg – 45 kg","medium":"49 kg – 54 kg"}],"docs":["Gebruikershandleiding 5DUCEK20I","Onderdelenboek 9CECK (CoEx)"],"serviceMenu":"old","serviceMenuNote":"Řízení ICeQ2: vždy staré servisní menu.","variants":[{"code":"CEC","cabinet":"Medium","brewer":"CoEx","doc":"70 and 90 series"},{"code":"CND","cabinet":"Small","brewer":"CoEx","doc":"60 and 80 series"},{"code":"FEC","cabinet":"Medium","brewer":"Filterfresh","doc":"40 series"},{"code":"FND","cabinet":"Small","brewer":"Filterfresh","doc":"20 series"},{"code":"IEA","cabinet":"Medium","brewer":"Instant","doc":"50 series"},{"code":"INB","cabinet":"Small","brewer":"Instant","doc":"10 series, 18 / 38 series"},{"code":"XEA","cabinet":"Medium","brewer":"CoEx XL","doc":"190 series"},{"code":"XNA","cabinet":"Small","brewer":"CoEx XL","doc":"180 series"}],"photo":"machines/virtu.webp","specsSource":"tm-avy-coex-medium-cec-da-v12, tm-avy-coex-small-cnd-da-v12"},{"id":"zia","name":"Zia","series":"1000, 2000, 4000, 5000, 6000 and 8000, 7000 and 9000, 18000, 19000","typeCode":"CEC / CND / FEC / FND / IEA / INB / XEA / XNA","brewer":"CoEx, CoEx XL, Filterfresh, Instant","cabinet":"Medium, Small","screen":"10,4\" touchscreen","active":true,"summary":"Všestranný stroj na filtrovanou i zrnkovou kávu, široce konfigurovatelný.","description":"Lze konfigurovat na filtrovanou kávu nebo zcela na zrna. Na výběr je počet zásobníků na zrna a zásobníků na mléčné, čokoládové nebo rostlinné prášky. Volitelně samostatná skříň s chladičem na neperlivou či perlivou vodu a průchodkou na odpad.","specs":[{"label":"Height","small":"815 mm","medium":"890 mm"},{"label":"Height with bean canister","small":"860 mm","medium":"1020 mm"},{"label":"Width","small":"365 mm","medium":"426 mm"},{"label":"Depth","small":"504 mm – 544 mm","medium":"590 mm"},{"label":"Weight","small":"40 kg – 45 kg","medium":"49 kg – 54 kg"}],"docs":["Onderdelenboek 9CECP (CoEx)"],"serviceMenu":"old","serviceMenuNote":"Řízení ICeQ2: vždy staré servisní menu.","variants":[{"code":"CEC","cabinet":"Medium","brewer":"CoEx","doc":"7000 and 9000 series"},{"code":"CND","cabinet":"Small","brewer":"CoEx","doc":"6000 and 8000 series"},{"code":"FEC","cabinet":"Medium","brewer":"Filterfresh","doc":"4000 series"},{"code":"FND","cabinet":"Small","brewer":"Filterfresh","doc":"2000 series"},{"code":"IEA","cabinet":"Medium","brewer":"Instant","doc":"5000 series"},{"code":"INB","cabinet":"Small","brewer":"Instant","doc":"1000 series"},{"code":"XEA","cabinet":"Medium","brewer":"CoEx XL","doc":"19000 series"},{"code":"XNA","cabinet":"Small","brewer":"CoEx XL","doc":"18000 series"}],"photo":"machines/zia.webp","specsSource":"tm-avy-coex-medium-cec-da-v12, tm-avy-coex-small-cnd-da-v12"},{"id":"nio","name":"Nio","series":"CKA serie","typeCode":"CKA / XKA","brewer":"CoEx, CoEx XL","cabinet":"Small","screen":"10,4\" touchscreen","active":false,"summary":"Kompaktní stolní model; předchůdce modelu Nio Next.","description":"Stolní model se spařovačem CoEx, dodávaný s kovovými nebo PPSU ventily. Pozor: katalog dílů dělí tlakový a parní bojler podle provedení a roku výroby