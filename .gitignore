# Page renders and drawings from those manuals. The app ships them, this public
# repo does not: kbtools/build_kb.sh rebuilds them from manuals/ when you have
# the PDFs. The drawings whose balloon numbers were read are the exception —
# those live in data/tek_ballon/, because the coordinates are useless without
# exactly those images.
app/src/main/assets/img/
app/src/main/assets/tek/
app/src/main/assets/stap/

# Photos of machines in the field: they carry a customer's serial number.
data/samples/

